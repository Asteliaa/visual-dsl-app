<%# ДОП: partial-карточка элемента. Подключение: include('partials/card', { item: item }) внутри тега вывода без экранирования %>
<div class="card" style="background:#fff;padding:12px 16px;margin:8px 0;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
    <h3 style="margin:0"><a href="/item/<%= item.id %><%= authQuery %>"><%= item.title %></a></h3>
    <span class="badge"><%= item.type %></span>
    <small class="muted"><%= formatDate(item.createdAt) %></small>
</div>
