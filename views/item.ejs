<%- include('partials/header') %>
<h1>Диаграмма: <%= item.title %></h1>
<dl>
    <dt>ID записи</dt><dd><%= item.id %></dd>
    <dt>Тип</dt><dd><span class="badge"><%= item.type %></span></dd>
    <dt>Создана</dt><dd><%= formatDate(item.createdAt) %></dd>
    <% if (item.updatedAt) { %>
        <dt>Изменена</dt><dd><%= formatDate(item.updatedAt) %></dd>
    <% } %>
</dl>
<h2>DSL-код</h2>
<pre><code><%= item.dsl %></code></pre>
<p><a href="/<%= authQuery %>">&larr; Вернуться к списку</a></p>
<%- include('partials/footer') %>
